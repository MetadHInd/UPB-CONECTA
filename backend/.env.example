# RF-01: la frecuencia es parametrizable sin recompilar.
# El planificador relee este valor en cada ciclo, de modo que un cambio
# surte efecto sin redesplegar la aplicacion (criterio de aceptacion 2).
INGESTION_INTERVAL_MS=300000
INGESTION_BATCH_SIZE=200

MAILBOX_HOST=imap.upb.edu.co
MAILBOX_PORT=993
MAILBOX_USER=upbconecta.recolector@upb.edu.co
MAILBOX_MAILBOX=INBOX

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=upb_conecta

# HU-05: parametros de reintento del adaptador del buzon (backoff exponencial)
# Numero de reintentos adicionales al intento inicial (por defecto 3)
MAILBOX_RETRY_MAX_ATTEMPTS=3
# Base del backoff exponencial en milisegundos (por defecto 1000)
MAILBOX_RETRY_BASE_MS=1000
# Tope maximo entre reintentos en milisegundos (por defecto 30000)
MAILBOX_RETRY_MAX_MS=30000

# Circuit Breaker: umbral de fallos consecutivos para abrir el circuito
MAILBOX_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# Tiempo de enfriamiento (cooldown) antes de probar half-open en ms
MAILBOX_CIRCUIT_BREAKER_COOLDOWN_MS=60000
