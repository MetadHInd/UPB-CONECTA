# RF-01: la frecuencia es parametrizable sin recompilar.
# El planificador relee este valor en cada ciclo, de modo que un cambio
# surte efecto sin redesplegar la aplicacion (criterio de aceptacion 2).
INGESTION_INTERVAL_MS=300000
INGESTION_BATCH_SIZE=200

MAILBOX_HOST=imap.upb.edu.co
MAILBOX_PORT=993
MAILBOX_USER=upbconecta.recolector@upb.edu.co
MAILBOX_MAILBOX=INBOX

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=upb_conecta

# HU-05: parametros de reintento del adaptador del buzon (backoff exponencial)
# Numero de reintentos adicionales al intento inicial (por defecto 3)
MAILBOX_RETRY_MAX_ATTEMPTS=3
# Base del backoff exponencial en milisegundos (por defecto 1000)
MAILBOX_RETRY_BASE_MS=1000
# Tope maximo entre reintentos en milisegundos (por defecto 30000)
MAILBOX_RETRY_MAX_MS=30000

# Circuit Breaker: umbral de fallos consecutivos para abrir el circuito
MAILBOX_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# Tiempo de enfriamiento (cooldown) antes de probar half-open en ms
MAILBOX_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# ---------------------------------------------------------------------------
# Servidor HTTP (src/http-server.ts) — HU-43/44/45: contrato REST que
# consume el Frontend (ver Frontend/ARQUITECTURA-INTEGRACION.md).
# ---------------------------------------------------------------------------
HTTP_PORT=3000

# HU-45, RNF-17: firma de los tokens de sesion (JWT HS256 via `jose`).
# Obligatorio, minimo 32 caracteres. Generar uno propio, nunca reutilizar
# este placeholder en un entorno real:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=cambiar-por-un-secreto-real-de-al-menos-32-caracteres
SESSION_TOKEN_ISSUER=upb-conecta
SESSION_TOKEN_AUDIENCE=upb-conecta-app
# Vigencia del token de acceso, en segundos (por defecto 15 minutos)
SESSION_ACCESS_TOKEN_TTL_SECONDS=900
# Vigencia del token de refresco, en segundos (por defecto 30 dias)
SESSION_REFRESH_TOKEN_TTL_SECONDS=2592000

# HU-43: rate limiting del inicio de sesion.
IDENTITY_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_RATE_LIMIT_MAX_PER_ACCOUNT=5
IDENTITY_RATE_LIMIT_MAX_PER_ORIGIN=10

# HU-37, criterio 5: semestre maximo admitido (10 semestres + internado de
# Medicina por defecto).
PROFILE_SEMESTER_MAX=12
