<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Mismo criterio que backup_rules.xml: la caché de
     convocatorias (HU-17) no se respalda ni se transfiere a otro dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="upb_conecta.db" />
        <exclude domain="database" path="upb_conecta.db-shm" />
        <exclude domain="database" path="upb_conecta.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="upb_conecta.db" />
        <exclude domain="database" path="upb_conecta.db-shm" />
        <exclude domain="database" path="upb_conecta.db-wal" />
    </device-transfer>
</data-extraction-rules>
