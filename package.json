  "description": "UPB Conecta - Contexto de ingesta del buzon institucional recolector (HU-01, RF-01, RF-02)",
  "type": "module",
  "scripts": {
    "build": "tsc -p config/tsconfig.json",
    "typecheck": "tsc -p config/tsconfig.json --noEmit",
